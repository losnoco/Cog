    "BassNoticeText" : {
      "comment" : "The notice which will be displayed the first time a configuration using BASSMIDI is detected on playback.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The BASSMIDI synthesizer has been replaced by SpessaSynth, an open-source SoundFont engine with support for SF2, SF3, and DLS banks. Your existing SoundFont selection has been preserved. If you experience any differences in MIDI playback, please report them via the GitHub issue tracker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sintetizador BASSMIDI ha sido reemplazado por SpessaSynth, un motor SoundFont de código abierto compatible con bancos SF2, SF3 y DLS. Tu selección actual de SoundFont se ha mantenido. Si notas alguna diferencia en la reproducción MIDI, por favor infórmalo a través de GitHub."
          }
        }
      }
    },
    "BassNoticeTitle" : {
      "comment" : "Title for the MIDI synthesizer notice for BASSMIDI deprecation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI Synthesizer Notice"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso sobre el sintetizador MIDI"
          }
        }
      }
    },
